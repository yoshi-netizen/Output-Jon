<div class="min-h-screen flex items-center justify-center bg-[#f5f5f3] py-16 px-4">
  <div class="w-full max-w-sm bg-white border border-gray-100 rounded-2xl p-8">

    <h2 class="text-xl font-bold text-gray-900 mb-1 tracking-tight">ログイン</h2>
    <p class="text-xs text-gray-400 mb-8">アカウントにサインインしてください</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="mb-5">
        <%= f.label :email, "メールアドレス", class: "block text-xs font-normal text-gray-600 mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary transition" %>
      </div>

      <div class="mb-5">
        <%= f.label :password, "パスワード", class: "block text-xs font-normal text-gray-600 mb-1.5" %>
        <%= f.password_field :password, autocomplete: "current-password",
            class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary transition" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2 mb-6">
          <%= f.check_box :remember_me, class: "w-4 h-4 accent-primary" %>
          <%= f.label :remember_me, "ログイン状態を保持する", class: "text-xs text-gray-500" %>
        </div>
      <% end %>

      <div class="mt-2">
        <%= f.submit "ログイン", class: "w-full py-2.5 text-sm font-normal text-white rounded-lg cursor-pointer transition hover:opacity-90 bg-primary" %>
      </div>

    <% end %>

    <div class="mt-6 text-center text-xs text-gray-400">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>