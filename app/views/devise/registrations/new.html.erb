<div class="min-h-screen flex items-center justify-center bg-[#f5f5f3] py-16 px-4">
  <div class="w-full max-w-sm bg-white border border-gray-100 rounded-2xl p-8">

    <h2 class="text-xl font-bold text-gray-900 mb-1 tracking-tight">新規登録</h2>
    <p class="text-xs text-gray-400 mb-8">アカウントを作成してください</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-5">
        <%= f.label :email, "メールアドレス", class: "block text-xs font-medium text-gray-600 mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-[#47a971] transition" %>
      </div>

      <div class="mb-5">
        <%= f.label :password, "パスワード", class: "block text-xs font-medium text-gray-600 mb-1.5" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mb-1"><%= @minimum_password_length %>文字以上</p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
            class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-[#47a971] transition" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, "パスワード（確認）", class: "block text-xs font-medium text-gray-600 mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-[#47a971] transition" %>
      </div>

      <div>
        <%= f.submit "アカウントを作成", class: "w-full py-2.5 text-sm font-medium text-white rounded-lg cursor-pointer transition hover:opacity-90", style: "background-color: #47a971;" %>
      </div>

    <% end %>

    <div class="mt-6 text-center text-xs text-gray-400">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>