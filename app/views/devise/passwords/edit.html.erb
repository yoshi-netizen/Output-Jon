<div class="grow flex items-center justify-center bg-primary py-16 px-4">
  <div class="w-full max-w-sm bg-white border border-gray-100 rounded-2xl p-8">

    <h2 class="text-xl font-bold text-gray-900 mb-1 tracking-tight">新しいパスワードの設定</h2>
    <p class="text-xs text-gray-400 mb-8">新しいパスワードを入力してください</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="mb-5">
        <%= f.label :password, "新しいパスワード", class: "block text-xs font-normal text-gray-600 mb-1.5" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mb-1"><%= @minimum_password_length %>文字以上</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
            class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary transition" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "block text-xs font-normal text-gray-600 mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary transition" %>
      </div>

      <div class="mt-2">
        <%= f.submit "パスワードを変更する", class: "w-full py-2.5 text-sm font-normal text-white rounded-lg cursor-pointer transition hover:opacity-90 bg-primary" %>
      </div>

    <% end %>

    <div class="mt-6 text-center text-xs text-gray-400">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>
