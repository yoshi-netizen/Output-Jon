<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-temporary class="text-red-500 border border-red-200 bg-red-50 p-4 mb-6 rounded-xl text-sm">
    <ul class="space-y-0.5">
      <% resource.errors.full_messages.each do |message| %>
        <li class="text-red-400">・<%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
