              <div class="border-t border-gray-100 my-1"></div>
              <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: "delete" }, class: "block px-4 py-2.5 text-sm text-red-500 hover:text-red-700 hover:bg-red-50 transition" %>
            </div>
          </div>

