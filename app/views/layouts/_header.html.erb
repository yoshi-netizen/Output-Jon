        <% else %>
          <%= link_to "ログイン", new_user_session_path, class: "text-sm font-normal px-4 py-2 rounded-md border transition text-primary border-primary" %>
          <%= link_to "新規登録", new_user_registration_path, class: "text-sm font-normal text-white px-4 py-2 rounded-md transition bg-primary" %>
