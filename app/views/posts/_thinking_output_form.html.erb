<div id="thinking_output_field">
  <%= label_tag "post[thinking_output]", '整理した考え' %>

  <div class="mt-2 mb-4">
  <%= link_to 'AIに整理してもらう', 
              generate_summary_post_path(@post), 
              method: :post, 
              data: { turbo: false },
              class: "bg-green-500 text-white py-1 px-3 rounded hover:bg-green-600" %>
  </div>

  <textarea name="post[thinking_output]" id="post_thinking_output" class="border border-gray-400 rounded px-3 py-2 w-full" rows="10"><%= post.thinking_output %></textarea>
</div>