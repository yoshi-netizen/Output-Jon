<div class="mt-4">
  <%# ラベルとAI生成ボタンを横並び %>
  <div class="flex items-center gap-2 mb-2">
    <%= label_tag "post[thinking_output]", '整理した考え', class: "font-medium" %>
    <%= link_to 'AIに整理してもらう', 
                generate_summary_post_path(post), 
                method: :post, 
                data: { turbo: false },
                class: "text-sm bg-green-500 text-white py-1 px-3 rounded hover:bg-green-600 whitespace-nowrap" %>
  </div>

  <%# thinking_output テキストエリア %>
  <div id="thinking_output_field">
    <textarea name="post[thinking_output]" id="post_thinking_output" class="border border-gray-400 rounded px-3 py-2 w-full" rows="10"><%= post.thinking_output %></textarea>
  </div>
</div>