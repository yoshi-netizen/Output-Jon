<div class="min-h-screen bg-[#f5f5f3] py-12 px-4">
  <div class="max-w-2xl mx-auto">

    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">整理した思考一覧</h1>
        <p class="text-sm text-gray-400 mt-1">これまでに整理した思考の記録です</p>
      </div>
      <%= link_to "＋ 新しく整理する", new_post_path,
          class: "text-sm font-normal text-white px-4 py-2 rounded-lg transition hover:opacity-90 whitespace-nowrap",
          style: "background-color: #47a971;" %>
    </div>

    <% if @posts.any? %>
      <ul class="space-y-3">
        <% @posts.each do |post| %>
          <li>
            <%= link_to post_path(post), class: "block bg-white border border-gray-100 rounded-xl p-5 hover:border-[#47a971] transition group" do %>
              <div class="flex items-center justify-between">
                <p class="text-sm font-normal text-gray-900 group-hover:text-[#47a971] transition">
                  <%= post.thinking_topic %>
                </p>
                <span class="text-xs text-gray-300 ml-4 whitespace-nowrap">
                  <%= post.created_at.strftime("%Y/%m/%d") %>
                </span>
              </div>
              <% if post.thinking_core.present? %>
                <p class="text-xs text-gray-400 mt-1.5"><%= post.thinking_core %></p>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>

    <% else %>
      <div class="bg-white border border-gray-100 rounded-2xl p-12 text-center">
        <p class="text-sm text-gray-400 mb-6">まだ投稿がありません。<br>まずは今の気持ちを整理してみましょう！</p>
        <%= link_to "思考を整理する", new_post_path,
            class: "text-sm font-normal text-white px-6 py-2.5 rounded-lg transition hover:opacity-90",
            style: "background-color: #47a971;" %>
      </div>
    <% end %>

  </div>
</div>