<div class="grow bg-primary py-12 px-4">
  <div class="max-w-2xl mx-auto">

    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-white tracking-tight">整理した思考一覧</h1>
        <p class="text-sm text-lime-100 mt-1">これまでに整理した思考の記録です</p>
      </div>
      <%= link_to "＋ 新しく整理する", new_post_path,
          class: "text-sm font-normal text-white px-4 py-2 rounded-lg transition hover:opacity-90 whitespace-nowrap bg-primary" %>
    </div>

    <%# 検索フォーム %>
    <%= search_form_for @q, class: "bg-white border border-gray-100 rounded-xl p-5 mb-6 space-y-4 sm:space-y-0 sm:flex sm:items-end sm:gap-4" do |f| %>
      <div class="flex-1">
        <%= f.label :thinking_topic_cont, "テーマ", class: "block text-sm font-bold text-gray-600 mb-1.5" %>
        <%= f.search_field :thinking_topic_cont, placeholder: "テーマを入力", class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary transition" %>
      </div>
      <div class="flex-1">
        <%= f.label :thinking_core_eq, "整理の目的", class: "block text-sm font-bold text-gray-600 mb-1.5" %>
        <%= f.select :thinking_core_eq,
                Post::CORE_THINKING_TYPES,
                { include_blank: 'すべて' },
                class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary transition bg-white" %>
      </div>
      <%= f.submit "検索する", class: "w-full sm:w-auto px-5 py-2.5 text-sm font-bold text-white rounded-lg cursor-pointer transition hover:opacity-90 bg-[#da8d6c]" %>
    <% end %>

    <% if @posts.present? %>
      <ul class="space-y-3">
        <% @posts.each do |post| %>
          <li>
            <%= link_to post_path(post), class: "block bg-white border border-gray-100 rounded-xl p-5 hover:border-primary transition group" do %>
              <div class="flex items-center justify-between">
                <p class="text-sm font-bold text-gray-900 group-hover:text-primary transition">
                  <%= post.thinking_topic %>
                </p>
                <span class="text-xs text-gray-400 ml-4 whitespace-nowrap">
                  <%= post.created_at.strftime("%Y/%m/%d") %>
                </span>
              </div>
              <% if post.thinking_core.present? %>
                <p class="text-xs text-gray-700 mt-1.5"><%= post.thinking_core %></p>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% elsif current_user.posts.exists? %>
      <div class="bg-white border border-gray-100 rounded-2xl p-12 text-center">
        <p class="text-sm text-gray-400 mb-6">検索結果がありませんでした。</p>
        <%= link_to "検索条件をリセット", posts_path,
            class: "text-sm font-normal text-white px-6 py-2.5 rounded-lg transition hover:opacity-90 bg-[#da8d6c]" %>
      </div>
    <% else %>
      <div class="bg-white border border-gray-100 rounded-2xl p-12 text-center">
        <p class="text-sm text-gray-400 mb-6">まだ投稿がありません。<br>まずは今の気持ちを整理してみましょう！</p>
        <%= link_to "思考を整理する", new_post_path,
            class: "text-sm font-normal text-white px-6 py-2.5 rounded-lg transition hover:opacity-90 bg-primary" %>
      </div>
    <% end %>

  </div>
</div>