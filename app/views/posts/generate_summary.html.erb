<turbo-frame id="ai_generator_trigger">

  <%# JavaScriptを使って、親階層（メインフォーム内）のtextareaにAI文章を流し込む %>
  <script>
    (function() {
      const outputTextarea = document.getElementById('post_thinking_output');
      if (outputTextarea) {
        // バックエンドから渡ってきたAI生成文章をそのままフォームにセット
        outputTextarea.value = <%= @post.thinking_output.to_json.html_safe %>;
      }
    })();
  </script>
</turbo-frame>