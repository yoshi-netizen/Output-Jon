<div class="min-h-screen bg-[#f5f5f3] py-12 px-4">
  <div class="max-w-2xl mx-auto">

    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">投稿の編集</h1>
        <p class="text-sm text-gray-400 mt-1">内容を修正して更新してください</p>
      </div>
      <%= link_to "← 詳細に戻る", post_path(@post), class: "text-sm text-gray-400 hover:text-gray-600 transition" %>
    </div>

    <%= form_with model: @post, local: true do |f| %>

      <%# --- エラーメッセージ表示 --- %>
      <% if @post.errors.any? %>
        <div id="error_explanation" class="text-red-500 border border-red-200 bg-red-50 p-4 mb-6 rounded-xl text-sm">
          <p class="font-medium mb-1"><%= @post.errors.count %>件のエラーにより保存できませんでした</p>
          <ul class="space-y-0.5">
            <% @post.errors.full_messages.each do |message| %>
              <li class="text-red-400">・<%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="bg-white border border-gray-100 rounded-2xl p-6 space-y-6">

        <%# テーマ %>
        <div>
          <%= f.label :thinking_topic, "整理したいテーマ", class: "block text-sm font-medium text-gray-600 mb-1.5" %>
          <%= f.text_field :thinking_topic,
              class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-[#47a971] transition" %>
        </div>

        <%# 箇条書き %>
        <div>
          <%= f.label :thinking_diffusion, "思考の書き出し", class: "block text-sm font-medium text-gray-600 mb-1.5" %>
          <%= f.text_area :thinking_diffusion,
              rows: 5,
              class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-[#47a971] transition resize-none" %>
        </div>

        <%# 整理の目的 %>
        <div>
          <%= f.label :thinking_core, "整理の目的", class: "block text-sm font-medium text-gray-600 mb-1.5" %>
          <%= f.select :thinking_core,
              ['【報連相】 どう伝えればいいか整理したい',
              '【学び・感想】 記事や講演の内容を自分の血肉にしたい',
              '【会議・打合せ】 決まったことと次やることを明確にしたい',
              '【壁打ち】 モヤモヤしていることを言語化したい'],
              { include_blank: '選択してください' },
              class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-[#47a971] transition bg-white" %>
        </div>

        <%# 整理した思考 + AIボタン %>
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :thinking_output, "整理した思考", class: "text-sm font-medium text-gray-600" %>
            <%= f.submit "AIで整理する", name: "generate_ai",
                class: "text-xs font-medium text-white px-3 py-1.5 rounded-lg cursor-pointer transition hover:opacity-90 whitespace-nowrap",
                style: "background-color: #da8d6c;" %>
          </div>
          <p class="text-xs text-gray-400 mb-1.5">⚠️「AIで整理する」ボタンをクリックすると内容が上書き保存されるので注意ください。⚠️</p>
          <div id="thinking_output_field">
            <%= f.text_area :thinking_output,
                rows: 10,
                class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-[#47a971] transition resize-none" %>
          </div>
        </div>
        <div class="mt-6 flex items-center gap-3">
          <%= f.submit "更新する",
              class: "text-sm font-medium text-white px-6 py-2.5 rounded-lg cursor-pointer transition hover:opacity-90",
              style: "background-color: #47a971;" %>
          <%= link_to "キャンセル", post_path(@post), class: "text-sm text-gray-400 hover:text-gray-600 transition" %>
        </div>
      </div>

    <% end %>

    <%# 新規作成から「保存してAI生成」で遷移してきた場合のみ、自動で裏のAPIを叩く仕組み %>
    <% if params[:ai_generate] == "true" %>
      <turbo-frame id="ai_generator_trigger" src="<%= generate_summary_post_path(@post) %>">
        <div class="mt-6 p-4 bg-white border border-[#47a971] rounded-xl text-center animate-pulse">
          <p class="text-sm font-medium" style="color: #47a971;">AIが思考を整理しています。しばらくお待ちください...</p>
        </div>
      </turbo-frame>
    <% end %>

  </div>
</div>