<div class="grow bg-primary py-12 px-4">
  <div class="max-w-2xl mx-auto">

    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-white tracking-tight">投稿の編集</h1>
        <p class="text-sm text-lime-100 mt-1">内容を修正して更新してください</p>
      </div>
      <%= link_to "← 詳細に戻る", post_path(@post), class: "text-sm text-white hover:text-lime-200 transition" %>
    </div>

    <%= form_with model: @post,
      data: {
        controller: "loading",
        action: "turbo:submit-start->loading#start turbo:submit-end->loading#end"
      } do |f| %>

      <%# --- エラーメッセージ表示 --- %>
      <% if @post.errors.any? %>
        <div id="error_explanation" class="text-red-500 border border-red-200 bg-red-50 p-4 mb-6 rounded-xl text-sm">
          <ul class="space-y-0.5">
            <% @post.errors.full_messages.each do |message| %>
              <li class="text-red-400">・<%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="bg-white border border-gray-100 rounded-2xl p-6 space-y-6">

        <%# テーマ %>
        <div>
          <%= f.label :thinking_topic, "整理したいテーマ", class: "block text-sm font-normal text-gray-600 mb-1.5" %>
          <%= f.text_field :thinking_topic,
              class: "field-error:border-red-500 field-error:bg-red-50 field-error:focus:border-red-500 w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary transition" %>
        </div>

        <%# 箇条書き %>
        <div>
          <%= f.label :thinking_diffusion, "思考の書き出し", class: "block text-sm font-normal text-gray-600 mb-1.5" %>
          <%= f.text_area :thinking_diffusion,
              rows: 5,
              class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary transition resize-none" %>
        </div>

        <%# 整理の目的 %>
        <div>
          <%= f.label :thinking_core, "整理の目的", class: "block text-sm font-normal text-gray-600 mb-1.5" %>
          <%= f.select :thinking_core,
              Post::CORE_THINKING_TYPES,
              { include_blank: '選択してください' },
              class: "w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary transition bg-white" %>
        </div>

        <%# 整理した思考 + AIボタン %>
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :thinking_output, "整理した思考", class: "text-sm font-bold text-gray-600" %>
            <%= f.button formaction: generate_summary_posts_path,
                        formmethod: :post,
                        data: { loading_target: "button" },
                        class: "text-sm font-bold text-white px-3 py-1.5 rounded-lg cursor-pointer transition hover:opacity-90 whitespace-nowrap bg-[#da8d6c]" do %>
              <span data-loading-target="label">AIで整理する</span>
              <span data-loading-target="spinner" class="hidden">
                <%= render "ai_spinner" %>
              </span>
            <% end %>
          </div>
          <div data-controller="clipboard"
              class="border border-gray-200 rounded-lg transition has-[textarea:focus]:border-primary">
            <%# ツールバー行（右寄せでコピーボタン） %>
            <div class="flex justify-end  border-gray-200">
              <%= button_tag type: "button",
                  data: { action: "click->clipboard#copy", clipboard_target: "button" },
                  class: "px-1 py-0.5 rounded-bl-lg rounded-tr-lg border border-gray-200 cursor-pointer transition hover:opacity-90 whitespace-nowrap disabled:cursor-default" do %>
                <span data-clipboard-target="label" class="material-symbols-outlined text-xs!">コピーcontent_copy</span>
              <% end %>
            </div>
            <%# 入力欄 %>
            <%= f.text_area :thinking_output,
                data: { clipboard_target: "text" },
                rows: 10,
                class: "block w-full px-3 pb-2.5 pt-1 text-sm border-0 rounded-lg focus:outline-none resize-none" %>
          </div>
        </div>
        <div class="mt-6 flex items-center gap-3">
          <%= f.submit "更新する",
              class: "text-sm font-normal text-white px-6 py-2.5 rounded-lg cursor-pointer transition hover:opacity-90 bg-primary" %>
          <%= link_to "キャンセル", post_path(@post), class: "text-sm text-gray-400 hover:text-gray-600 transition" %>
        </div>
      </div>

    <% end %>

  </div>
</div>