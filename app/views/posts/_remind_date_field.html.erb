<%# リマインド日付 %>
<div>
  <%= f.label :remind_date, "リマインド日付", class: "block text-sm font-bold text-gray-600 mb-1.5" %>
  <%= f.date_field :remind_date,
      class: "w-full px-3 py-2.5 mb-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary transition bg-white" %>
  <p class="text-xs text-gray-400 mb-1.5">リマインド日付を設定すると、設定日の午前8時に通知が送られます。</p>
  <% if current_user.line_user? %>
    <p class="text-xs text-gray-400 mb-1.5">LINEで通知したい場合は、事前に友だち追加が必要です。</p>
    <p class="text-xs text-gray-400 mb-1.5"><%= link_to "友達追加はこちらから行えます。", "https://lin.ee/zxRbHNy", class: "hover:underline", target: "_blank" %></p>
  <% end %>
</div>